)
(rule "60664 Outer DGND/HS"
	(layer outer)
	(constraint creepage (min 8mm))
	(condition "A.hasNetclass('DGND') && B.hasNetclass('IBUS')")
)
(rule "60664 Outer  Earth/SWN1"
