	(condition "A.hasNetclass('DGND') && B.hasNetclass('SWN2') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "60664 DGND/SWN3"
	(layer outer)
	(constraint clearance (min 3mm))
	(condition "A.hasNetclass('DGND') && B.hasNetclass('SWN3') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "60664 Outer DGND/SWN1"
	(layer outer)
	(constraint creepage (min 8mm))
	(condition "A.hasNetclass('DGND') && B.hasNetclass('SWN1')")
)
(rule "60664 Outer DGND/SWN2"
	(layer outer)
	(constraint creepage (min 8mm))
	(condition "A.hasNetclass('DGND') && B.hasNetclass('SWN2')")
