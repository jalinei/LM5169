(version 1)
(rule "60664 Outer DGND/PGND"
	(layer outer)
	(constraint creepage (min 8mm))
	(condition "A.hasNetclass('DGND') && B.hasNetclass('PGND')")
)
(rule "60664 Outer  Earth/PGND"
	(layer outer)
	(constraint creepage (min 4mm))
	(condition "A.hasNetclass('Earth') && B.hasNetclass('PGND')")
)
(rule "60664 PGND/Earth"
	(constraint clearance (min 4mm))
	(condition "A.hasNetclass('PGND') && B.hasNetclass('Earth')")
)
(rule "IPC2221 A6 Pads SWN1/PGND"
	(layer outer)
	(constraint clearance (min 0.8mm))
	(condition "A.hasNetclass('SWN1') && B.hasNetclass('PGND') && (A.Type == 'Pad' || B.Type == 'Pad')")
)
(rule "IPC2221 A6 Pads SWN1/HS"
	(layer outer)
	(constraint clearance (min 0.8mm))
	(condition "A.hasNetclass('SWN1') && B.hasNetclass('IBUS') && (A.Type == 'Pad' || B.Type == 'Pad')")
)
(rule "IPC2221 B4 Tracks SWN1/PGND"
	(layer outer)
	(constraint clearance (min 0.4mm))
	(condition "A.hasNetclass('SWN1') && B.hasNetclass('PGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "IPC2221 B4 Tracks SWN1/HS"
	(layer outer)
	(constraint clearance (min 0.4mm))
	(condition "A.hasNetclass('SWN1') && B.hasNetclass('IBUS') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "IPC2221 B4 Tracks HS/PGND"
	(layer outer)
	(constraint clearance (min 0.4mm))
	(condition "A.hasNetclass('IBUS') && B.hasNetclass('PGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "IPC2221 A6 Pads HS/PGND"
	(layer outer)
	(constraint clearance (min 0.8mm))
	(condition "A.hasNetclass('IBUS') && B.hasNetclass('PGND') && (A.Type == 'Pad' || B.Type == 'Pad')")
)
(rule "IPC2221 B1 Tracks SWN1/PGND"
	(layer inner)
	(constraint clearance (min 0.2mm))
	(condition "A.hasNetclass('SWN1') && B.hasNetclass('PGND')")
)
(rule "IPC2221 B1 Tracks SWN1/HS"
	(layer inner)
	(constraint clearance (min 0.2mm))
	(condition "A.hasNetclass('SWN1') && B.hasNetclass('IBUS')")
)
(rule "IPC2221 B1 Tracks HS/PGND"
	(layer inner)
	(constraint clearance (min 0.2mm))
	(condition "A.hasNetclass('IBUS') && B.hasNetclass('PGND')")
)
(rule "60664 DGND/PGND"
	(constraint clearance (min 3mm))
	(condition "A.hasNetclass('DGND') && B.hasNetclass('PGND')")
)
(rule "60664 SWN1/Earth"
	(constraint clearance (min 4mm))
	(condition "A.hasNetclass('SWN1') && B.hasNetclass('Earth')")
)
(rule "60664 HS/Earth"
	(constraint clearance (min 4mm))
	(condition "A.hasNetclass('IBUS') && B.hasNetclass('Earth')")
)
(rule "60664 DGND/HS"
	(constraint clearance (min 3mm))
	(condition "A.hasNetclass('DGND') && B.hasNetclass('IBUS')")
)
(rule "60664 DGND/SWN1"
	(constraint clearance (min 3mm))
	(condition "A.hasNetclass('DGND') && B.hasNetclass('SWN1')")
)
(rule "60664 Outer DGND/SWN1"
	(layer outer)
	(constraint creepage (min 8mm))
	(condition "A.hasNetclass('DGND') && B.hasNetclass('SWN1')")
)
(rule "60664 Outer DGND/HS"
	(layer outer)
	(constraint creepage (min 8mm))
	(condition "A.hasNetclass('DGND') && B.hasNetclass('IBUS')")
)
(rule "60664 Outer  Earth/SWN1"
	(layer outer)
	(constraint creepage (min 4mm))
	(condition "A.hasNetclass('Earth') && B.hasNetclass('SWN1')")
)
(rule "60664 Outer  Earth/HS"
	(layer outer)
	(constraint creepage (min 4mm))
	(condition "A.hasNetclass('Earth') && B.hasNetclass('IBUS')")
)
