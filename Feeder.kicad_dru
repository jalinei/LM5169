(version 1)
(rule "60664 Outer DGND/PGND"
	(layer outer)
	(constraint creepage (min 8mm))
	(condition "A.hasNetclass('DGND') && B.hasNetclass('PGND')")
)
(rule "60664 Outer  Earth/PGND"
	(layer outer)
	(constraint creepage (min 4mm))
	(condition "A.hasNetclass('Earth') && B.hasNetclass('PGND')")
)
(rule "60664 PGND/Earth"
	(layer outer)
	(constraint clearance (min 4mm))
	(condition "A.hasNetclass('PGND') && B.hasNetclass('Earth')")
)
(rule "IPC2221 A6 Pads SWN1/PGND"
	(layer outer)
	(constraint clearance (min 0.8mm))
	(condition "A.hasNetclass('SWN1') && A.Type == 'Pad' && B.hasNetclass('PGND') && B.Type == 'Pad'")
)
(rule "IPC2221 A6 Pads SWN1/HS"
	(layer outer)
	(constraint clearance (min 0.8mm))
	(condition "A.hasNetclass('SWN1') && A.Type == 'Pad' && B.hasNetclass('IBUS') && B.Type == 'Pad'")
)
(rule "IPC2221 B4 Tracks SWN1/PGND"
	(layer outer)
	(constraint clearance (min 0.4mm))
	(condition "A.hasNetclass('SWN1') && B.hasNetclass('PGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "IPC2221 B4 Tracks SWN1/HS"
	(layer outer)
	(constraint clearance (min 0.4mm))
	(condition "A.hasNetclass('SWN') && B.hasNetclass('IBUS') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "IPC2221 B4 Tracks HS/PGND"
	(layer outer)
	(constraint clearance (min 0.4mm))
	(condition "A.hasNetclass('IBUS') && B.hasNetclass('PGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via' || B.Type == 'Pad')")
)
(rule "IPC2221 A6 Pads HS/PGND"
	(layer outer)
	(constraint clearance (min 0.8mm))
	(condition "A.hasNetclass('IBUS') && A.Type == 'Pad' && B.hasNetclass('PGND') && B.Type == 'Pad'")
)
(rule "IPC2221 B1 Tracks SWN/PGND"
	(layer inner)
	(constraint clearance (min 0.2mm))
	(condition "A.hasNetclass('SWN') && B.hasNetclass('PGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "IPC2221 B1 Tracks SWN1/HS"
	(layer inner)
	(constraint clearance (min 0.2mm))
	(condition "A.hasNetclass('SWN1') && B.hasNetclass('IBUS') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "IPC2221 B1 Tracks HS/PGND"
	(layer inner)
	(constraint clearance (min 0.2mm))
	(condition "A.hasNetclass('IBUS') && B.hasNetclass('PGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "60664 DGND/PGND"
	(layer outer)
	(constraint clearance (min 3mm))
	(condition "A.hasNetclass('DGND') && B.hasNetclass('PGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "IPC2221 A6 Pads SWN2/PGND"
	(layer outer)
	(constraint clearance (min 2.415mm))
	(condition "A.hasNetclass('SWN2') && A.Type == 'Pad' && B.hasNetclass('PGND') && B.Type == 'Pad'")
)
(rule "IPC2221 A6 Pads SWN3/PGND"
	(layer outer)
	(constraint clearance (min 2.415mm))
	(condition "A.hasNetclass('SWN3') && A.Type == 'Pad' && B.hasNetclass('PGND') && B.Type == 'Pad'")
)
(rule "IPC2221 A6 Pads SWN2/HS"
	(layer outer)
	(constraint clearance (min 2.415mm))
	(condition "A.hasNetclass('SWN2') && A.Type == 'Pad' && B.hasNetclass('IBUS') && B.Type == 'Pad'")
)
(rule "IPC2221 A6 Pads SWN3/HS"
	(layer outer)
	(constraint clearance (min 2.415mm))
	(condition "A.hasNetclass('SWN') && A.Type == 'Pad' && B.hasNetclass('IBUS') && B.Type == 'Pad'")
)
(rule "IPC2221 B4 Tracks SWN2/PGND"
	(layer outer)
	(constraint clearance (min 1.715mm))
	(condition "A.hasNetclass('SWN2') && B.hasNetclass('PGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "IPC2221 B4 Tracks SWN3/PGND"
	(layer outer)
	(constraint clearance (min 1.715mm))
	(condition "A.hasNetclass('SWN3') && B.hasNetclass('PGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "IPC2221 B4 Tracks SWN2/HS"
	(layer outer)
	(constraint clearance (min 1.715mm))
	(condition "A.hasNetclass('SWN2') && B.hasNetclass('IBUS') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "IPC2221 B4 Tracks SWN3/HS"
	(layer outer)
	(constraint clearance (min 1.715mm))
	(condition "A.hasNetclass('SWN3') && B.hasNetclass('IBUS') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "IPC2221 B1 Tracks SWN2/PGND"
	(layer inner)
	(constraint clearance (min 1mm))
	(condition "A.hasNetclass('SWN2') && B.hasNetclass('PGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "IPC2221 B1 Tracks SWN3/PGND"
	(layer inner)
	(constraint clearance (min 1mm))
	(condition "A.hasNetclass('SWN3') && B.hasNetclass('PGND') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via' || A.Type == 'Pad') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "60664 SWN1/Earth"
	(layer outer)
	(constraint clearance (min 4mm))
	(condition "A.hasNetclass('SWN1') && B.hasNetclass('Earth')")
)
(rule "60664 SWN2/Earth"
	(layer outer)
	(constraint clearance (min 4mm))
	(condition "A.hasNetclass('SWN2') && B.hasNetclass('Earth')")
)
(rule "60664 SWN3/Earth"
	(layer outer)
	(constraint clearance (min 4mm))
	(condition "A.hasNetclass('SWN3') && B.hasNetclass('Earth')")
)
(rule "60664 HS/Earth"
	(layer outer)
	(constraint clearance (min 4mm))
	(condition "A.hasNetclass('IBUS') && B.hasNetclass('Earth')")
)
(rule "60664 DGND/HS"
	(layer outer)
	(constraint clearance (min 3mm))
	(condition "A.hasNetclass('DGND') && B.hasNetclass('IBUS') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
)
(rule "60664 DGND/SWN1"
	(layer outer)
	(constraint clearance (min 3mm))
	(condition "A.hasNetclass('DGND') && B.hasNetclass('SWN1') && (A.Type == 'Track' || A.Type == 'Zone' || A.Type == 'Via') && (B.Type == 'Track' || B.Type == 'Zone' || B.Type == 'Via')")
